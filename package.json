{
  "name": "michaeltlombardi-resume",
  "version": "2.0.0",
  "description": "Resume for Michael T. Lombardi",
  "watch": {
    "update": {
      "patterns": [
        "resume.yaml"
      ],
      "ignore": [
        "node_modules",
        "public"
      ],
      "runOnChangeOnly": false
    }
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "update": "yaml2json resume.yaml > resume.json",
    "prevalidate": "npm run update",
    "validate": "resumefy validate",
    "preserve": "npm run validate",
    "serve": "resumefy render --outDir public --watch",
    "preexport": "npm run validate",
    "export": "resumefy render --outDir public",
    "watch": "concurrently \"npm-watch update\" \"npm run serve\""
  },
  "dependencies": {
    "jsonresume-theme-even": "^0.26.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "npm-watch": "^0.13.0",
    "resumefy": "^1.6.0",
    "yamljs": "0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaeltlombardi/resume.git"
  },
  "keywords": [],
  "author": "Michael T. Lombardi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/michaeltlombardi/resume/issues"
  },
  "homepage": "https://michaeltlombardi.github.io/resume",
  "allowScripts": {
    "core-js@3.49.0": true,
    "puppeteer@24.5.0": true
  }
}
